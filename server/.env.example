# PostgreSQL ulanish manzili
DATABASE_URL=postgres://postgres@localhost:5432/bookmall
# Kamida 32 belgili tasodifiy maxfiy kalit (masalan: openssl rand -base64 48)
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
# Google Cloud Console'dan olingan OAuth Client ID'lar (vergul bilan): Web, Android, iOS
GOOGLE_CLIENT_IDS=xxxx.apps.googleusercontent.com
PORT=3000
# Yuklangan rasm/videolar papkasi va tashqi manzil (ixtiyoriy)
UPLOAD_DIR=uploads
# PUBLIC_BASE_URL=https://api.bookmall.uz
